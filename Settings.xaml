<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译 · 设置" Width="500" Height="740" MinWidth="450" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D8E2E3"/><Setter Property="Foreground" Value="#233337"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4B6268"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="7,0,0,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid Margin="23,18,23,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="连接你的模型" FontSize="22" FontWeight="SemiBold" Foreground="#233337"/>
      <TextBlock Text="填写服务商提供的地址、密钥和模型名称。" FontSize="12" Foreground="#7C9095" Margin="0,7,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <TextBlock Text="API 地址（包含版本路径，例如 /v1）" Margin="0,0,0,6"/>
        <TextBox Name="BaseBox" AutomationProperties.Name="API 地址"/>
        <TextBlock Text="例如 https://api.openai.com/v1，也支持完整接口地址。" FontSize="10" Foreground="#889A9F" TextWrapping="Wrap" Margin="0,5,0,14"/>
        <TextBlock Text="API 密钥" Margin="0,0,0,6"/>
        <PasswordBox Name="KeyBox" Padding="9,7" BorderBrush="#D8E2E3" AutomationProperties.Name="API 密钥"/>
        <TextBlock Text="由 Windows 加密保存在本机，不写入程序或日志。" FontSize="10" Foreground="#889A9F" Margin="0,5,0,14"/>
        <TextBlock Text="模型名称" Margin="0,0,0,6"/>
        <ComboBox Name="ModelBox" IsEditable="True" DisplayMemberPath="Id" IsTextSearchEnabled="False" MaxDropDownHeight="250" AutomationProperties.Name="模型名称"/>
        <Grid Margin="0,8,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Name="FetchModelsButton" Content="读取模型列表" Margin="0" Padding="9,6"/>
          <Button Grid.Column="1" Name="TestModelButton" Content="测试当前模型" Padding="9,6" ToolTip="发送 Hello 做短翻译，会消耗少量模型用量"/>
        </Grid>
        <TextBlock Text="接口协议" Margin="0,0,0,6"/>
        <ComboBox Name="ProtocolBox" AutomationProperties.Name="接口协议">
          <ComboBoxItem Content="Chat Completions（OpenAI 兼容）"/>
          <ComboBoxItem Content="Responses（OpenAI）"/>
        </ComboBox>
        <CheckBox Name="PassOnlyCheck" Content="仅显示 ClinePass 订阅模型" Margin="0,12,0,0" ToolTip="Cline 的通用模型目录包含按量计费模型，此选项读取专门的订阅目录"/>
        <Expander Header="高级选项与缓存" Margin="0,18,0,0">
          <StackPanel Margin="0,12,0,4">
            <TextBlock Text="Chat 接口的输出上限参数" Margin="0,0,0,6"/>
            <ComboBox Name="TokenBox" AutomationProperties.Name="输出上限参数">
              <ComboBoxItem Content="max_completion_tokens（OpenAI）"/>
              <ComboBoxItem Content="max_tokens（部分兼容服务商）"/>
              <ComboBoxItem Content="不发送（由服务商控制）"/>
            </ComboBox>
            <TextBlock Text="请求输出上限 token（512–8192；查词最多 512）" Margin="0,12,0,6" FontSize="11"/>
            <TextBox Name="LimitBox" AutomationProperties.Name="最大输出 token"/>
            <CheckBox Name="UsageCheck" Content="请求流式 token 用量" Margin="0,13,0,0"/>
            <TextBlock Text="若接口报 stream_options 不支持，可取消勾选。" FontSize="10" Foreground="#889A9F" Margin="0,5,0,0"/>
            <CheckBox Name="ThinkingCheck" Content="在支持的模型上关闭思考，降低用量" Margin="0,14,0,0" ToolTip="ClinePass 仅对已验证支持此选项的模型发送关闭请求；强制思考的模型保持默认行为"/>
            <CheckBox Name="CacheCheck" Content="启用本地加密缓存（最多 200 条）" Margin="0,14,0,0"/>
            <TextBlock Text="关闭会清空已有缓存。只有完整结果会写入缓存。" FontSize="10" Foreground="#889A9F" Margin="0,5,0,0"/>
            <Button Name="ClearCacheButton" Content="清空缓存" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          </StackPanel>
        </Expander>
        <TextBlock Text="读取列表不生成文本；测试会发送一个短句。保存设置不会发起网络请求。" TextWrapping="Wrap" Foreground="#889A9F" FontSize="11" Margin="0,18,0,8"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Name="ErrorLabel" Foreground="#AD5E38" TextWrapping="Wrap" MaxHeight="80" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Name="CancelButton" Content="取消" IsCancel="True"/>
        <Button Name="SaveButton" Content="保存设置" IsDefault="True" Background="#176D64" Foreground="White"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
