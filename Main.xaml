<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译 · Lingo Float" Width="460" Height="690" MinWidth="400" MinHeight="630"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#233337"/>
    <SolidColorBrush x:Key="Muted" Color="#75848A"/>
    <SolidColorBrush x:Key="Accent" Color="#176D64"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#E9EEEF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#338B80"/><Setter TargetName="Bg" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#52656A"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="SelectionBrush" Value="#68B5A7"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22,18,22,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Background="#176D64" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
            <TextBlock Text="译" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="随译" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="LINGO FLOAT" FontSize="9" Foreground="#85959A" Margin="10,12,0,0"/>
        </StackPanel>
        <TextBlock Text="让阅读顺畅一点" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
      </StackPanel>
      <Button Name="SettingsButton" Content="设置" HorizontalAlignment="Right" VerticalAlignment="Top" Background="White" ToolTip="配置 API、模型与缓存"/>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,20,0,12">
    <Grid>
      <StackPanel Orientation="Horizontal">
        <CheckBox Name="PinCheck" Content="置顶" Margin="0,0,18,0"/>
        <CheckBox Name="AutoCheck" Content="自动翻译" ToolTip="原文停止变化 800 毫秒后翻译；取消勾选可手动提交"/>
      </StackPanel>
      <TextBlock Name="HotkeyLabel" Text="Ctrl+Alt+T 呼出" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox Name="MainModelBox" DisplayMemberPath="Label" IsTextSearchEnabled="True" MaxDropDownHeight="300" Padding="7,6" FontSize="12" AutomationProperties.Name="切换模型"/>
      <Button Grid.Column="1" Name="RefreshModelsButton" Content="刷新" Padding="10,6" Margin="7,0,0,0" Background="White" ToolTip="只读取模型列表，不发起翻译"/>
    </Grid>
    </StackPanel>
    <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8EA" BorderThickness="1" Padding="15,12,15,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="原文" Foreground="#536A6F" FontWeight="SemiBold"/>
          <TextBlock Name="CountLabel" Text="0 / 6000" HorizontalAlignment="Right" Foreground="#94A2A6" FontSize="11"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,8">
          <TextBox Name="InputBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="15" Padding="0,3" AutomationProperties.Name="原文输入"/>
          <TextBlock Name="InputHint" Text="在这里粘贴单词、句子或段落…" IsHitTestVisible="False" Foreground="#A0ADB0" FontSize="14" Margin="1,5,0,0"/>
        </Grid>
        <Grid Grid.Row="2">
          <StackPanel Orientation="Horizontal">
            <Button Name="PasteButton" Content="粘贴" Padding="10,6" Background="#F0F4F4"/>
            <Button Name="ClearButton" Content="清空" Padding="10,6" Margin="6,0,0,0" Background="Transparent" Foreground="#7D8D91"/>
          </StackPanel>
          <ComboBox Name="ModeBox" HorizontalAlignment="Right" Width="93" VerticalContentAlignment="Center" AutomationProperties.Name="翻译模式">
            <ComboBoxItem Content="自动识别"/>
            <ComboBoxItem Content="单词查词"/>
            <ComboBoxItem Content="直接翻译"/>
          </ComboBox>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E2E8EA" BorderThickness="1" Padding="15,12,15,12" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Name="ResultHeading" Text="译文" Foreground="#536A6F" FontWeight="SemiBold"/>
            <Border Name="CacheBadge" Background="#E4F2EB" CornerRadius="4" Padding="5,1" Margin="8,-1,0,0" Visibility="Collapsed">
              <TextBlock Text="本地缓存" Foreground="#45805F" FontSize="10"/>
            </Border>
          </StackPanel>
          <Button Name="CopyButton" Content="复制" HorizontalAlignment="Right" Padding="6,0" Background="Transparent" Foreground="#688187" IsEnabled="False"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,12,0,10">
          <TextBox Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0" FontSize="15" Background="Transparent" AutomationProperties.Name="翻译结果"/>
          <StackPanel Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="随手一贴，即刻读懂" Foreground="#8C9DA2" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="单词查音标与释义 · 句子看翻译" Foreground="#AFBABD" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <ProgressBar Name="BusyBar" Grid.Row="2" Height="3" Foreground="#3A9185" Background="#EDF3F2" IsIndeterminate="True" Visibility="Hidden" BorderThickness="0"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,13,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Name="TranslateButton" Content="翻译  ↵" Background="{StaticResource Accent}" Foreground="White" Padding="20,9" ToolTip="Ctrl+Enter 翻译"/>
          <Button Name="StopButton" Content="停止" Margin="8,0,0,0" IsEnabled="False" ToolTip="Esc 停止接收"/>
        </StackPanel>
        <Button Name="UsageButton" Content="用量" HorizontalAlignment="Right" Background="Transparent" Foreground="#74888D" Padding="9,9"/>
      </Grid>
      <TextBlock Name="StatusLabel" Text="先设置 API，即可开始翻译" TextWrapping="Wrap" MaxHeight="48" Foreground="#687F85" FontSize="11" Margin="0,12,0,5" AutomationProperties.Name="状态"/>
      <Grid>
        <TextBlock Name="ModelLabel" Text="尚未配置模型" Foreground="#97A5A9" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,145,0"/>
        <TextBlock Name="UsageLabel" Text="今日 0 次 · 0 token" HorizontalAlignment="Right" Foreground="#97A5A9" FontSize="10"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
